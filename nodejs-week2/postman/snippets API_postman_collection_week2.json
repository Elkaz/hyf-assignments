{
  "info": {
    "name": "Week 2 - Snippets API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Snippets API endpoints for Parts A-E (sorting, public feed, user filter, create)"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "snippetId",
      "value": "1"
    },
    {
      "key": "userId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "GET /api/snippets",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is an array\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(Array.isArray(jsonData)).to.eql(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/snippets",
          "host": ["{{baseUrl}}"],
          "path": ["api", "snippets"]
        },
        "description": "Returns all snippets ordered by created_at desc"
      },
      "response": []
    },
    {
      "name": "GET /api/snippets/sort?sort=title,asc",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/snippets/sort?sort=title,asc",
          "host": ["{{baseUrl}}"],
          "path": ["api", "snippets", "sort"],
          "query": [
            {
              "key": "sort",
              "value": "title,asc"
            }
          ]
        },
        "description": "Returns sorted snippets using validated sort query"
      },
      "response": []
    },
    {
      "name": "GET /api/snippets/unsafe?sort=created_at desc; DROP TABLE users;--",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has data field\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('data');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/snippets/unsafe?sort=created_at desc; DROP TABLE users;--",
          "host": ["{{baseUrl}}"],
          "path": ["api", "snippets", "unsafe"],
          "query": [
            {
              "key": "sort",
              "value": "created_at desc; DROP TABLE users;--"
            }
          ]
        },
        "description": "Unsafe endpoint for SQL injection demonstration"
      },
      "response": []
    },
    {
      "name": "GET /api/snippets/public",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/snippets/public",
          "host": ["{{baseUrl}}"],
          "path": ["api", "snippets", "public"]
        },
        "description": "Returns only public snippets"
      },
      "response": []
    },
    {
      "name": "GET /api/snippets/users/:userId",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/snippets/users/{{userId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "snippets", "users", "{{userId}}"]
        },
        "description": "Returns snippets by user id"
      },
      "response": []
    },
    {
      "name": "POST /api/snippets",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Created successfully\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response has id\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": 1,\n  \"title\": \"Test snippet\",\n  \"contents\": \"Hello world\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/snippets",
          "host": ["{{baseUrl}}"],
          "path": ["api", "snippets"]
        },
        "description": "Creates a new snippet"
      },
      "response": []
    }
  ]
}
